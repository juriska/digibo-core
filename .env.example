# DigiBo API Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Mock Mode (set to 'true' for local development with mock data)
MOCK_ENABLED=true

# Oracle Database Configuration (required when MOCK_ENABLED=false)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CONNECTION_STRING=localhost:1521/XEPDB1

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://preview--digi-backstage-haven.lovable.app